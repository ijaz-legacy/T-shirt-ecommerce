# IJAZ LEGACY — Apache configuration for InfinityFree

# ── Protect config ─────────────────────────────────────────────────────
<Files "config.php">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</Files>

# ── Protect install.php after setup ────────────────────────────────────
# Uncomment the block below after running the installer:
# <Files "install.php">
#   <IfModule mod_authz_core.c>
#     Require all denied
#   </IfModule>
#   <IfModule !mod_authz_core.c>
#     Order allow,deny
#     Deny from all
#   </IfModule>
# </Files>

Options -Indexes

# ── Make PHP the default entry point ───────────────────────────────────
# InfinityFree (and most Apache hosts) look for index.html before index.php.
# This line overrides that priority so index.php is tried first.
DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Serve real files and directories directly (CSS, JS, images, etc.)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Redirect a direct hit on /index.php to / so the URL stays clean
  RewriteRule ^index\.php$ / [R=301,L]

  # Route every other request through the front controller
  RewriteRule ^ index.php [L]
</IfModule>

# ── Security headers ────────────────────────────────────────────────────
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "DENY"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ── Long cache for static assets ───────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png          "access plus 1 year"
  ExpiresByType image/webp         "access plus 1 year"
  ExpiresByType image/jpeg         "access plus 1 year"
  ExpiresByType image/svg+xml      "access plus 1 year"
  ExpiresByType text/css           "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType application/json   "access plus 0 seconds"
</IfModule>

# ── Compression ────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript
</IfModule>

# ── PHP settings (InfinityFree allows these via .htaccess) ──────────────
<IfModule mod_php8.c>
  php_value upload_max_filesize 8M
  php_value post_max_size 10M
  php_value max_execution_time 60
  php_value memory_limit 128M
</IfModule>
<IfModule mod_php7.c>
  php_value upload_max_filesize 8M
  php_value post_max_size 10M
  php_value max_execution_time 60
  php_value memory_limit 128M
</IfModule>
