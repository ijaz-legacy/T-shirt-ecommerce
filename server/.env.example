# Copy this file to server/.env and fill in the values.
# All of them come from Supabase → Project Settings → API.

# Project URL, e.g. https://abcdefghijk.supabase.co
SUPABASE_URL=

# Public anon key — used to verify customer access tokens.
SUPABASE_ANON_KEY=

# Secret service-role key — server only. NEVER expose this to the browser.
# Required for order tracking: public.track_order() is executable by
# service_role only, so GET /api/orders/track/:number returns 503 without it.
# Without it the rest of the API still runs, but every query is limited by RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Trusted proxy hops in front of the API (0 = off). Set to 1 on Render, Railway,
# Fly or behind nginx so per-IP rate limiting sees the real client address.
TRUST_PROXY=0

# Storage bucket for image uploads (must exist and be public).
SUPABASE_STORAGE_BUCKET=client-images

# HTTP port for the API.
PORT=4000

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Accounts that always count as staff/owner.
OWNER_EMAILS=theijazlegacy@gmail.com,ijazlegacy@gmail.com
