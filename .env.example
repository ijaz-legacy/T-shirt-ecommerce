# Turso database (production and remote development)
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Public site URL used for metadata and Open Graph tags
# Set this to your deployed address, for example:
# NEXT_PUBLIC_SITE_URL=https://your-site.netlify.app
NEXT_PUBLIC_SITE_URL=

# Local development only. Defaults to ./data/ijaz-legacy.db when unset.
# IJAZ_DB_PATH=./data/ijaz-legacy.db
