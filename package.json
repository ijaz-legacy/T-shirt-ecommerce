{
  "name": "ijaz-store",
  "version": "1.0.0",
  "private": true,
  "description": "IJAZ LEGACY — fullstack printed & custom tee store (React SPA + Express API + Supabase Postgres)",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "npm run dev --workspace @ijaz/client",
    "dev:api": "npm run dev --workspace @ijaz/server",
    "build": "npm run build --workspace @ijaz/client",
    "build:api": "npm run build --workspace @ijaz/server",
    "start": "npm run start --workspace @ijaz/server",
    "typecheck": "npm run typecheck --workspace @ijaz/server && npm run typecheck --workspace @ijaz/client"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=18"
  }
}
